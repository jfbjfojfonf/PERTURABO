+  .cand .metrics .bar i { display: block; height: 100%; background: linear-gradient(90deg, var(--gold-dim), var(--gold-bright)); }
+  .cand .metrics .bar i.hot { background: linear-gradient(90deg, #a67c00, #39d353); }
+  .cand .metrics .lbl b { color: var(--gold-bright); font-size: 12px; }
+  .cand .metrics .lbl .vs { color: var(--phosphor); }
+  .cand .score { font-size: 21px; font-weight: 800; color: var(--phosphor); text-align: right; }
+  .cand .score small { display: block; font-size: 10px; color: var(--text-dim); font-weight: 400; letter-spacing: 1px; }
+  .gate { display: flex; gap: 8px; }
+  button.gate-btn { padding: 7px 16px; border-radius: 4px; border: 1px solid; background: transparent;
+                    font-weight: 700; letter-spacing: 1px; cursor: pointer; font-size: 12px; transition: .15s; }
+  .gate-btn.approve { color: var(--green); border-color: var(--green); }
+  .gate-btn.approve:hover:not(:disabled) { background: var(--green); color: var(--black-plate); }
+  .gate-btn.reject { color: var(--red); border-color: var(--red); }
+  .gate-btn.reject:hover:not(:disabled) { background: var(--red); color: var(--black-plate); }
+  .gate-btn:disabled { opacity: .55; cursor: default; }
+  .cand.approved { border-left-color: var(--green); }
+  .cand.rejected { border-left-color: var(--red); opacity: .6; }
+  .verdict-tag { font-size: 11px; letter-spacing: 1px; padding: 4px 10px; border-radius: 3px; }
+  .verdict-tag.approved { background: rgba(46,160,67,.15); color: var(--green); }
+  .verdict-tag.rejected { background: rgba(248,81,73,.15); color: var(--red); }
+
+  /* ── Données brutes : distribution + JSON ── */
+  .hist { display: flex; align-items: flex-end; gap: 4px; height: 110px; padding: 6px 2px 0; }
+  .hist .bin { flex: 1; display: flex; flex-direction: column; justify-content: flex-end; align-items: center; gap: 4px; height: 100%; }
+  .hist .bin i { display: block; width: 100%; background: linear-gradient(180deg, var(--gold-bright), var(--gold-dim));
+                 border-radius: 2px 2px 0 0; min-height: 2px; }
+  .hist .bin span { font-size: 9.5px; color: var(--text-dim); }
+  .hist .bin b { font-size: 10.5px; color: var(--text); font-weight: 600; }
+  .hist-lbl { display: flex; justify-content: space-between; font-size: 10.5px; color: var(--text-dim); margin-top: 4px; }
+  details.rawsec { border: 1px solid var(--boltgun); border-radius: 4px; margin-top: 10px; background: var(--black-plate); }
+  details.rawsec summary { cursor: pointer; padding: 9px 14px; color: var(--text-dim); font-size: 12px; letter-spacing: .5px; }
+  details.rawsec summary b { color: var(--gold-dim); }
+  details.rawsec pre { max-height: 300px; overflow: auto; padding: 0 14px 12px; font-size: 11px; color: #9ecbff; line-height: 1.45; }
+  .note { color: var(--text-dim); font-size: 12px; margin-top: 8px; }
+  .note b { color: #d29922; }
+  footer { border-top: 1px solid var(--boltgun); padding: 14px 28px; color: var(--text-dim);
+           font-size: 11.5px; display: flex; justify-content: space-between; flex-wrap: wrap; gap: 8px; }
+  footer a { color: var(--gold-dim); text-decoration: none; }
+</style>
+</head>
+<body>
+<div class="hazard-strip"></div>
+<header>
+  <div class="sigil"><span>IV</span></div>
+  <div>
+    <h1>Salle de Guerre — F00C</h1>
+    <div class="sub">« Le Primarque voit tous les points d'intérêt depuis son siège. »</div>
+  </div>
+  <div id="mode-badge" class="badge vod">MODE VOD</div>
+</header>
+
+<main>
+  <div id="err-banner"></div>
+
+  <div class="video-strip">
+    <span class="vt" id="v-title">—</span>
+    <span class="vc" id="v-channel"></span>
+    <span class="coverage" id="v-coverage">—</span>
+  </div>
+
+  <div class="stats">
+    <div class="stat"><div class="k">Statut</div><div class="v" id="st-status" style="font-size:16px">—</div></div>
+    <div class="stat"><div class="k">Durée vidéo</div><div class="v" id="st-dur" style="font-size:16px">—</div></div>
+    <div class="stat"><div class="k">Runs reçus</div><div class="v" id="st-runs">0</div></div>
+    <div class="stat"><div class="k">Candidats</div><div class="v" id="st-cands">0</div></div>
+    <div class="stat"><div class="k">Intensité moy.</div><div class="v" id="st-mean">—</div></div>
+    <div class="stat"><div class="k">Gate — GO</div><div class="v" id="st-approved" style="color:var(--green)">0</div></div>
+    <div class="stat"><div class="k">Gate — NO-GO</div><div class="v" id="st-rejected" style="color:var(--red)">0</div></div>
+  </div>
+
+  <div class="panel">
+    <h2>Timeline maîtresse <span class="hint">— survole pour lire les valeurs exactes · clique un segment candidat</span></h2>
+    <div class="tl-wrap">
+      <div class="y-axis" id="y-axis"></div>
+      <div class="chart-zone" id="chart-zone">
+        <svg class="curves" id="curves" viewBox="0 0 1000 160" preserveAspectRatio="none"></svg>
+        <div class="cursor" id="cursor"></div>
+        <div class="tooltip" id="tooltip"></div>
+      </div>
+      <div class="x-axis" id="x-axis"></div>
+    </div>
+    <div class="legend" id="legend">
+      <span class="l-heat on"><i></i>Heatmap F00C (capteur vidéo)</span>
+      <span class="l-replayed" id="leg-replayed"><i></i>Barre rouge Most Replayed</span>
+      <span class="l-fused on" id="leg-fused"><i></i>Fusion 0.6 / 0.4</span>
+      <span class="l-cand on"><i></i>Segments candidats</span>
+    </div>
+    <div class="note" id="replayed-note"></div>
+  </div>
+
+  <div class="panel">
+    <h2>File des candidats <span class="hint">— la Gate Warsmith commande ici · clique une carte pour la situer sur la timeline</span></h2>
+    <div class="cand-list" id="cand-list"></div>
+    <div class="note">Verdicts enregistrés via <b>POST /api/gate</b> — le pipeline lit la boucle de retour.</div>
+  </div>
+
+  <div class="panel">
+    <h2>Données brutes <span class="hint">— graphiques + métal brut, le Prince voit tout</span></h2>
+    <h2 style="margin-top:4px"><span class="hint" style="font-size:12px">Distribution des intensités du capteur (60 buckets, attention normalisée 0→1)</span></h2>
+    <div class="hist" id="hist"></div>
+    <div class="hist-lbl"><span>0.0 — calme</span><span>intensité normalisée</span><span>1.0 — pic</span></div>
+    <details class="rawsec"><summary><b>▸ JSON — manifeste complet du run</b> (curves, métadonnées, notes)</summary><pre id="raw-run"></pre></details>
+    <details class="rawsec"><summary><b>▸ JSON — candidats enrichis</b> (scores, timestamps exacts, plateformes)</summary><pre id="raw-cands"></pre></details>
+    <details class="rawsec"><summary><b>▸ JSON — verdicts de la Gate</b> (boucle de retour Warsmith)</summary><pre id="raw-gates"></pre></details>
+  </div>
+</main>
+
+<footer>
+  <span>PERTURABO · F00C_VOX — La Voix des Plateformes</span>
+  <span id="last-push">—</span>
+  <a href="/radar">Radar live F00B →</a>
+</footer>
+
+<script>
+'use strict';
+const POLL_MS = 5000;
+let seenCands = new Set();
+let currentRunId = null;
+let chartState = null;          // { dur, heat, fused, replayed, cands }
+
+const $ = (id) => document.getElementById(id);
+
+function showError(msg) {
+  const b = $('err-banner');
+  b.style.display = 'block';
+  b.innerHTML = '<b>⚠ Erreur de rendu :</b> ' + String(msg).replace(/[<>]/g, '');
+}
+function clearError() { $('err-banner').style.display = 'none'; }
+
+function fmtClock(s) {
+  if (s == null || isNaN(s)) return '—';
+  const total = Math.round(s);
+  const h = Math.floor(total / 3600), m = Math.floor((total % 3600) / 60), sec = total % 60;
+  return h ? `${h}:${String(m).padStart(2,'0')}:${String(sec).padStart(2,'0')}` : `${m}:${String(sec).padStart(2,'0')}`;
+}
+function fmtDur(s) {
+  if (s == null) return '—';
+  return fmtClock(s) + ' (' + (Math.round(s/60)) + ' min)';
+}
+function esc(t) { const d = document.createElement('div'); d.textContent = t == null ? '' : String(t); return d.innerHTML; }
+
+/* ══════════ TIMELINE : axes gradués + tooltips + candidats ══════════ */
+function niceStep(dur) {
+  const steps = [60, 120, 300, 600, 900, 1800, 3600];
+  for (const s of steps) { if (dur / s <= 8) return s; }
+  return 7200;
+}
+
+function renderTimeline(run) {
+  const heat = run.heatmap || [];
+  const fused = run.fused_heatmap || [];
+  const replayed = run.replayed_curve || [];
+  const cands = run.candidates || [];
+  const svg = $('curves');
+
+  if (!heat.length) {
+    svg.innerHTML = '';
+    $('x-axis').innerHTML = '';
+    $('y-axis').innerHTML = '';
+    $('replayed-note').textContent = 'Aucune heatmap dans ce run (metadata_only ?).';
+    chartState = null;
+    return;
+  }
+  const dur = Math.max(heat[heat.length - 1].end_sec || 1, 1);
+  const x = (t) => (t / dur) * 1000;
+  const y = (v) => 160 - (Math.min(Math.max(v ?? 0, 0), 1)) * 150 - 5;
+
+  const area = (rows, valKey, startKey, endKey) => rows.length
+    ? `M0,160 L${x(rows[0][startKey] ?? 0)},${y(rows[0][valKey])} ` +
+      rows.map(r => `L${x((r[startKey] + r[endKey]) / 2)},${y(r[valKey])}`).join(' ') +
+      ` L${x(rows[rows.length - 1][endKey] ?? dur)},160 Z`
+    : '';
+
+  let out = '';
+  // grille horizontale (0 / 0.25 / 0.5 / 0.75 / 1.0)
+  [0.25, 0.5, 0.75].forEach(g => {
+    out += `<line x1="0" x2="1000" y1="${y(g)}" y2="${y(g)}" stroke="rgba(107,112,117,.15)" stroke-dasharray="3,5" stroke-width="1" vector-effect="non-scaling-stroke"/>`;
+  });
+  out += `<path d="${area(heat, 'attention_norm', 'start_sec', 'end_sec')}" fill="rgba(212,160,23,.30)" stroke="#d4a017" stroke-width="1.5" vector-effect="non-scaling-stroke"/>`;
+
+  if (replayed.length) {
+    const maxVal = Math.max(...replayed.map(r => r.value || 0)) || 1;
+    const rp = 'M' + replayed.map(r =>
+      `${x(r.start)},${y(r.value / maxVal)} L${x(r.end)},${y(r.value / maxVal)}`
+    ).join(' L') + ` L${x(dur)},160 L0,160 Z`;
+    out += `<path d="${rp}" fill="rgba(248,81,73,.20)" stroke="#f85149" stroke-width="1.2" stroke-dasharray="5,4" vector-effect="non-scaling-stroke"/>`;
+  }
+  if (fused.length) {
+    out += `<path d="${area(fused, 'fused_norm', 'start_sec', 'end_sec')}" fill="none" stroke="#f0c040" stroke-width="1.6" vector-effect="non-scaling-stroke"/>`;
+  }
+  cands.forEach((c, i) => {
+    const w = Math.max(((c.end_sec ?? 0) - (c.start_sec ?? 0)) / dur * 1000, 3);
+    const gx = (c.start_sec ?? 0) / dur * 1000;
+    out += `<rect class="cand-block" data-ci="${i}" x="${gx}" y="4" width="${w}" height="152"
+             fill="rgba(57,211,83,.15)" stroke="#39d353" stroke-width="1.2" rx="2" style="cursor:pointer"/>`;
+  });
+  svg.innerHTML = out;
+
+  // Axe X gradué (labels en divs : jamais déformés par preserveAspectRatio)
+  const step = niceStep(dur);
+  let ticks = '';
+  for (let t = 0; t <= dur; t += step) {
+    ticks += `<span style="left:${(t / dur * 100)}%">${fmtClock(t)}</span>`;
+  }
+  $('x-axis').innerHTML = ticks;
+
+  // Axe Y (gauche)
+  $('y-axis').innerHTML =
+    `<span style="top:2%">1.0</span><span style="top:50%">0.5</span><span style="top:96%">0.0</span>`;
+
+  // Légende truthful : présence réelle de chaque courbe
+  const lr = $('leg-replayed');
+  lr.className = 'l-replayed ' + (replayed.length ? 'on' : 'off');
+  lr.innerHTML = replayed.length
+    ? '<i></i>Barre rouge Most Replayed — <b style="color:var(--replayed)">présente</b>'
+    : '<i></i>Barre rouge Most Replayed — <b>absente</b> (YouTube ne l\'expose pas ici)';
+  const lf = $('leg-fused');
+  lf.className = 'l-fused ' + (fused.length ? 'on' : 'off');
+  lf.innerHTML = fused.length
+    ? '<i></i>Fusion 0.6 capteur / 0.4 humains — <b style="color:var(--fused)">active</b>'
+    : '<i></i>Fusion — inactive (pas de barre rouge)';
+
+  chartState = { dur, heat, fused, replayed, cands };
+}
+
+/* Tooltip au survol : temps exact + valeurs capteur / fusion */
+function bindChartHover() {
+  const zone = $('chart-zone');
+  const cursor = $('cursor'), tip = $('tooltip');
+  zone.onmousemove = (ev) => {
+    if (!chartState) return;
+    const rect = zone.getBoundingClientRect();
+    const frac = Math.min(Math.max((ev.clientX - rect.left) / rect.width, 0), 1);
+    const t = frac * chartState.dur;
+    cursor.style.display = 'block';
+    cursor.style.left = (frac * 100) + '%';
+    const find = (rows, vk) => rows.find(r => t >= (r.start_sec ?? r.start) && t < (r.end_sec ?? r.end));
+    const hb = find(chartState.heat, 'attention_norm');
+    const fb = find(chartState.fused, 'fused_norm');
+    const inCand = chartState.cands.find(c => t >= (c.start_sec ?? 0) && t < (c.end_sec ?? 0));
+    tip.style.display = 'block';
+    const flip = frac > 0.7;
+    tip.style.left = flip ? '' : (frac * 100 + 1.5) + '%';
+    tip.style.right = flip ? ((1 - frac) * 100 + 1.5) + '%' : '';
+    tip.style.top = '8px';
+    tip.innerHTML =
+      `<div class="tt">⏱ ${fmtClock(t)}</div>` +
+      (hb ? `<div class="row"><span class="sw" style="background:var(--gold)"></span>capteur : <b>${(hb.attention_norm ?? 0).toFixed(3)}</b></div>` : '') +
+      (fb ? `<div class="row"><span class="sw" style="background:var(--fused)"></span>fusion : <b>${(fb.fused_norm ?? 0).toFixed(3)}</b></div>` : '') +
+      (inCand ? `<div class="row"><span class="sw" style="background:var(--phosphor)"></span>candidat #${esc(inCand.rank ?? '?')} — ${esc(inCand.start_label ?? fmtClock(inCand.start_sec))} → ${esc(inCand.end_label ?? fmtClock(inCand.end_sec))}</div>` : '');
+  };
+  zone.onmouseleave = () => { cursor.style.display = 'none'; tip.style.display = 'none'; };
+  zone.onclick = (ev) => {
+    if (ev.target.classList && ev.target.classList.contains('cand-block')) {
+      selectCandidate(parseInt(ev.target.dataset.ci, 10));
+    }
+  };
+}
+
+function selectCandidate(index) {
+  document.querySelectorAll('.cand').forEach(el => el.classList.remove('selected'));
+  const card = document.querySelector(`.cand[data-ci="${index}"]`);
+  if (card) { card.classList.add('selected'); card.scrollIntoView({ behavior: 'smooth', block: 'center' }); }
+  document.querySelectorAll('.cand-block').forEach(b => b.setAttribute('fill', 'rgba(57,211,83,.15)'));
+  const block = document.querySelector(`.cand-block[data-ci="${index}"]`);
+  if (block) block.setAttribute('fill', 'rgba(57,211,83,.45)');
+}
+
+/* ══════════ CANDIDATS : cartes complètes ══════════ */
+function renderCandidates(run, gates) {
+  const list = $('cand-list');
+  list.innerHTML = '';
+  const cands = run.candidates || [];
+  $('st-cands').textContent = cands.length;
+  if (!cands.length) {
+    list.innerHTML = '<div class="note">Aucun candidat dans ce run.</div>';
+    return;
+  }
+  const mean = run.mean_attention;
+  [...cands].sort((a, b) => (b.score ?? 0) - (a.score ?? 0)).forEach((c) => {
+    const ci = (run.candidates || []).indexOf(c);
+    const g = (gates || {})[c.id];
+    const inten = c.signal_intensity ?? (c.score != null ? c.score / 100 : 0);
+    const pct = Math.round(Math.min(Math.max(inten * 100, 0), 100));
+    const vs = c.vs_mean_pct;
+    const vsTxt = (vs != null) ? `<span class="vs">${vs > 0 ? '+' : ''}${vs}% vs moyenne</span>` : '';
+    const div = document.createElement('div');
+    div.className = 'cand' + (run.mode === 'live' && !seenCands.has(c.id) ? ' new-in-live' : '')
+                  + (g ? (g.verdict === 'approved' ? ' approved' : ' rejected') : '');
+    div.dataset.ci = ci;
+    div.onclick = () => selectCandidate(ci);
+    div.innerHTML = `
+      <div class="rank">#${esc(c.rank ?? '?')}</div>
+      <div class="info">
+        <div class="t">${esc(c.start_label ?? fmtClock(c.start_sec))} → ${esc(c.end_label ?? fmtClock(c.end_sec))}
+          <span class="dur">⏱ ${esc(c.duration_sec != null ? Math.round(c.duration_sec) + ' s' : '?')}</span></div>
+        <div class="d"><span class="pos">position : ${pctOf(c, run)} de la vidéo</span>
+          · ${esc((c.signal_type || 'signal').replace('_', ' '))}
+          · ${(c.platforms || []).join(' · ') || 'tronc PUR'}</div>
+      </div>
+      <div class="metrics">
+        <div class="lbl">intensité <b>${(inten).toFixed(2)}</b> ${vsTxt}</div>
+        <div class="bar"><i class="${inten >= 0.9 ? 'hot' : ''}" style="width:${pct}%"></i></div>
+      </div>
+      <div class="score">${c.score != null ? Number(c.score).toFixed(1) : '—'}<small>SCORE /100</small></div>`;
+    const gate = document.createElement('div');
+    gate.className = 'gate';
+    if (g) {
+      gate.innerHTML = `<span class="verdict-tag ${g.verdict}">${g.verdict === 'approved' ? '✔ GO' : '✘ NO-GO'}</span>`;
+    } else {
+      const ok = document.createElement('button');
+      ok.className = 'gate-btn approve'; ok.textContent = 'GO';
+      ok.onclick = (ev) => { ev.stopPropagation(); decide(c.id, 'approved', ok, no); };
+      const no = document.createElement('button');
+      no.className = 'gate-btn reject'; no.textContent = 'NO-GO';
+      no.onclick = (ev) => { ev.stopPropagation(); decide(c.id, 'rejected', ok, no); };
+      gate.append(ok, no);
+    }
+    div.appendChild(gate);
+    list.appendChild(div);
+    if (run.mode === 'live') seenCands.add(c.id);
+  });
+}
+
+function pctOf(c, run) {
+  const dur = run.duration_total_sec;
+  if (!dur || c.start_sec == null) return '? %';
+  return Math.round(c.start_sec / dur * 100) + ' %';
+}
+
+/* ══════════ GATE ══════════ */
+async function decide(candidateId, verdict, okBtn, noBtn) {
+  okBtn.disabled = noBtn.disabled = true;
+  try {
+    const res = await fetch('/api/gate', {
+      method: 'POST', headers: { 'Content-Type': 'application/json' },
+      body: JSON.stringify({ run_id: currentRunId, candidate_id: candidateId, verdict })
+    });
+    if (!res.ok) {
+      const body = await res.json().catch(() => ({}));
+      throw new Error(body.error || ('HTTP ' + res.status));
+    }
+    await refresh();
+  } catch (err) {
+    showError('Gate refusée par le serveur : ' + err.message);
+    okBtn.disabled = noBtn.disabled = false;
+  }
+}
+
+/* ══════════ DONNÉES BRUTES ══════════ */
+function renderRaw(doc) {
+  const run = doc.last_run || {};
+  const heat = run.heatmap || [];
+  const hist = $('hist');
+  if (heat.length) {
+    const NB = 12, bins = new Array(NB).fill(0);
+    heat.forEach(b => {
+      const v = Math.min(Math.max(b.attention_norm ?? 0, 0), 0.9999);
+      bins[Math.floor(v * NB)]++;
+    });
+    const max = Math.max(...bins, 1);
+    hist.innerHTML = bins.map((n, i) =>
+      `<div class="bin" title="intensité ${(i / NB).toFixed(2)}–${((i + 1) / NB).toFixed(2)} : ${n} bucket(s)">
+         <b>${n || ''}</b><i style="height:${Math.round(n / max * 82)}%"></i><span>${(i / NB).toFixed(1)}</span>
+       </div>`).join('');
+  } else {
+    hist.innerHTML = '<div class="note">Pas de distribution (heatmap absente).</div>';
+  }
+  $('raw-run').textContent = JSON.stringify(run, null, 2);
+  $('raw-cands').textContent = JSON.stringify(run.candidates || [], null, 2);
+  $('raw-gates').textContent = JSON.stringify({ counts: doc.gate_counts, verdicts: doc.last_verdicts || {}, gates: doc.gates || {} }, null, 2);
+}
+
+/* ══════════ RENDU GLOBAL ══════════ */
+function render(doc) {
+  const run = doc.last_run || {};
+  currentRunId = run.run_id || null;
+  const gates = (doc.gates || {})[run.run_id || ''] || {};
+  const live = run.mode === 'live';
+  const badge = $('mode-badge');
+  badge.textContent = live ? '● MODE LIVE — EN FIL DE L\'EAU' : 'MODE VOD — RÉTROSPECTIVE';
+  badge.className = 'badge ' + (live ? 'live' : 'vod');
+
+  $('v-title').textContent = run.title || run.siege_id || '—';
+  $('v-channel').textContent = run.channel ? 'par ' + run.channel : '';
+  const cov = run.coverage_pct;
+  const covEl = $('v-coverage');
+  if (cov != null) {
+    const full = cov >= 99.5;
+    covEl.className = 'coverage ' + (full ? 'full' : 'partial');
+    covEl.innerHTML = `analysé : <b>${fmtClock(run.analyzed_duration_sec)} / ${fmtClock(run.duration_total_sec)}</b> (${cov}%)` +
+      (full ? ' ✔ complet' : ' ⚠ partiel');
+  } else {
+    covEl.textContent = '';
+  }
+
+  $('st-status').textContent = run.status || '—';
+  $('st-dur').textContent = fmtDur(run.duration_total_sec);
+  $('st-runs').textContent = doc.total_runs ?? 0;
+  $('st-mean').textContent = run.mean_attention != null ? Number(run.mean_attention).toFixed(2) : '—';
+  const counts = doc.gate_counts || {};
+  $('st-approved').textContent = counts.approved || 0;
+  $('st-rejected').textContent = counts.rejected || 0;
+  $('last-push').textContent = doc.last_pushed_at ? ('Dernière poussée : ' + doc.last_pushed_at.replace('T', ' — ').slice(0, 19) + ' UTC') : '—';
+
+  renderTimeline(run);
+  renderCandidates(run, gates);
+  renderRaw(doc);
+}
+
+async function refresh() {
+  try {
+    const res = await fetch('/api/war-room');
+    if (!res.ok) throw new Error('HTTP ' + res.status);
+    render(await res.json());
+    clearError();
+  } catch (err) {
+    showError('Salle de Guerre injoignable (' + err.message + ') — nouvelle tentative dans ' + (POLL_MS / 1000) + ' s.');
+  }
+}
+
+bindChartHover();
+refresh();
+setInterval(refresh, POLL_MS);
+</script>
+</body>
+</html>
