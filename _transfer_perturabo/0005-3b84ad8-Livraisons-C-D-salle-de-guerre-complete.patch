+<script>
+const POLL_MS = 5000;              // LIVE : polling /api/war-room
+let seenRuns = new Set();          // détection « nouveau candidat en LIVE »
+let currentRunId = null;
+
+const $ = (id) => document.getElementById(id);
+
+function fmtTime(s) {
+  if (s == null) return '—';
+  const m = Math.floor(s / 60), sec = Math.round(s % 60);
+  return m > 0 ? `${m}m${String(sec).padStart(2, '0')}s` : `${sec}s`;
+}
+
+function render(doc) {
+  const run = doc.last_run || {};
+  currentRunId = run.run_id || null;
+  const gates = (doc.gates || {})[run.run_id || ''] || {};
+  const cands = run.candidates || [];
+
+  // Badge mode + stats
+  const live = run.mode === 'live';
+  const badge = $('mode-badge');
+  badge.textContent = live ? '● MODE LIVE — EN FIL DE L\'EAU' : 'MODE VOD — RÉTROSPECTIVE';
+  badge.className = 'badge ' + (live ? 'live' : 'vod');
+  $('st-siege').textContent = run.siege_id || '—';
+  $('st-status').textContent = run.status || '—';
+  $('st-runs').textContent = doc.total_runs ?? 0;
+  $('st-cands').textContent = cands.length;
+  const counts = doc.gate_counts || {};
+  $('st-approved').textContent = counts.approved || 0;
+  $('st-rejected').textContent = counts.rejected || 0;
+  $('last-push').textContent = doc.last_pushed_at ? ('Dernière poussée : ' + doc.last_pushed_at) : '—';
+
+  renderTimeline(run, cands);
+  renderCandidates(run, cands, gates, live);
+  renderRaw(doc);
+
+  if (live) { cands.forEach(c => seenRuns.add(c.id)); }
+}
+
+function renderTimeline(run, cands) {
+  const tl = $('timeline');
+  const heat = run.heatmap || [];
+  const replayed = run.replayed_curve || [];
+  const fused = run.fused_heatmap || [];
+  const note = $('replayed-note');
+  if (!heat.length) {
+    tl.innerHTML = '<div style="padding:18px;color:var(--text-dim)">Aucune heatmap dans ce run (metadata_only ?).</div>';
+    note.textContent = run.replayed_note ? ('Barre rouge : ' + run.replayed_note) : '';
+    return;
+  }
+  const dur = Math.max(heat[heat.length - 1].end_sec || 0, 1);
+  const x = (t) => (t / dur) * 1000;           // viewBox 1000×150
+  const y = (v) => 150 - (v ?? 0) * 140 - 5;
+
+  const poly = (rows, valKey, startKey, endKey) => rows.length
+    ? `M0,150 L${x(rows[0][startKey] ?? 0)},${y(rows[0][valKey])} ` +
+      rows.map(r => `L${x((r[startKey] + r[endKey]) / 2)},${y(r[valKey])}`).join(' ') +
+      ` L${x(rows[rows.length - 1][endKey] ?? dur)},150 Z`
+    : '';
+
+  const heatPath = poly(heat, 'attention_norm', 'start_sec', 'end_sec');
+  const fusedPath = poly(fused, 'fused_norm', 'start_sec', 'end_sec');
+
+  // barre rouge = courbe en escalier
+  let replayPath = '';
+  if (replayed.length) {
+    const maxVal = Math.max(...replayed.map(r => r.value || 0)) || 1;
+    replayPath = 'M' + replayed.map(r =>
+      `${x(r.start)},${150 - (r.value / maxVal) * 140 - 5} L${x(r.end)},${150 - (r.value / maxVal) * 140 - 5}`
+    ).join(' L') + ` L${x(dur)},150 L0,150 Z`;
+  }
+
+  const candBlocks = cands.map(c => {
+    const w = Math.max(((c.end_sec ?? 0) - (c.start_sec ?? 0)) / dur * 1000, 3);
+    const gx = (c.start_sec ?? 0) / dur * 1000;
+    const approved = '';
+    return `<rect x="${gx}" y="4" width="${w}" height="142" fill="rgba(57,211,83,.14)"
+             stroke="#39d353" stroke-width="1.2" rx="2"><title>#${c.rank} ${fmtTime(c.start_sec)} → ${fmtTime(c.end_sec)}</title></rect>`;
+  }).join('');
+
+  tl.innerHTML = `
+    <svg class="heat-svg" viewBox="0 0 1000 150" preserveAspectRatio="none">
+      <path d="${heatPath}" fill="rgba(212,160,23,.30)" stroke="#d4a017" stroke-width="1.5"/>
+      ${replayPath ? `<path d="${replayPath}" fill="rgba(248,81,73,.18)" stroke="#f85149" stroke-width="1.2" stroke-dasharray="5,4"/>` : ''}
+      ${fusedPath ? `<path d="${fusedPath}" fill="none" stroke="#f0c040" stroke-width="1.6"/>` : ''}
+      ${candBlocks}
+    </svg>`;
+  note.innerHTML = replayed.length
+    ? 'Barre rouge : <b>most replayed récupéré</b> — croisement capteur × comportement humain réel actif (fusion 0.6/0.4).'
+    : (run.replayed_note ? ('Barre rouge : <b>' + run.replayed_note + '</b>') : '');
+}
+
+function renderCandidates(run, cands, gates, live) {
+  const list = $('cand-list');
+  list.innerHTML = '';
+  if (!cands.length) {
+    list.innerHTML = '<div class="note">Aucun candidat dans ce run.</div>';
+    return;
+  }
+  [...cands].sort((a, b) => (b.score ?? b.attention_norm ?? 0) - (a.score ?? a.attention_norm ?? 0))
+    .forEach(c => {
+      const g = gates[c.id];
+      const div = document.createElement('div');
+      div.className = 'cand' + (live && !seenRuns.has(c.id) ? ' new-in-live' : '')
+                    + (g ? (g.verdict === 'approved' ? ' approved' : ' rejected') : '');
+      const platforms = (c.platforms || []).join(' · ');
+      div.innerHTML = `
+        <div class="rank">#${c.rank ?? '?'}</div>
+        <div class="info">
+          <div class="t">${fmtTime(c.start_sec)} → ${fmtTime(c.end_sec)}</div>
+          <div class="d">${platforms || 'plateformes : tronc PUR'}${c.signal_type ? ' · ' + c.signal_type : ''}${c.id ? ' · ' + c.id : ''}</div>
+        </div>
+        <div class="score">${(c.score ?? c.attention_norm ?? 0).toFixed ? (c.score ?? c.attention_norm).toFixed(2) : c.score}</div>`;
+      const gate = document.createElement('div');
+      gate.className = 'gate';
+      if (g) {
+        gate.innerHTML = `<span class="verdict-tag ${g.verdict}">${g.verdict === 'approved' ? '✔ GO' : '✘ NO-GO'}</span>`;
+      } else {
+        const ok = document.createElement('button');
+        ok.className = 'gate-btn approve'; ok.textContent = 'GO';
+        ok.onclick = () => decide(c.id, 'approved', ok, no);
+        const no = document.createElement('button');
+        no.className = 'gate-btn reject'; no.textContent = 'NO-GO';
+        no.onclick = () => decide(c.id, 'rejected', ok, no);
+        gate.append(ok, no);
+      }
+      div.appendChild(gate);
+      list.appendChild(div);
+    });
+}
+
+async function decide(candidateId, verdict, okBtn, noBtn) {
+  okBtn.disabled = noBtn.disabled = true;
+  try {
+    const res = await fetch('/api/gate', {
+      method: 'POST', headers: { 'Content-Type': 'application/json' },
+      body: JSON.stringify({ run_id: currentRunId, candidate_id: candidateId, verdict })
+    });
+    if (!res.ok) throw new Error('HTTP ' + res.status);
+    await refresh();
+  } catch (err) {
+    alert('Gate refusée par le serveur : ' + err.message);
+    okBtn.disabled = noBtn.disabled = false;
+  }
+}
+
+function renderRaw(doc) {
+  const chk = $('raw-chk'), pre = $('raw');
+  if (!chk.dataset.bound) {
+    chk.addEventListener('change', () => { pre.hidden = !chk.checked; });
+    chk.dataset.bound = '1';
+  }
+  pre.textContent = JSON.stringify(doc, null, 2);
+}
+
+async function refresh() {
+  try {
+    const res = await fetch('/api/war-room');
+    render(await res.json());
+  } catch (_) { /* réseau momentanément indisponible : on retentera */ }
+}
+refresh();
+setInterval(refresh, POLL_MS);
+</script>
