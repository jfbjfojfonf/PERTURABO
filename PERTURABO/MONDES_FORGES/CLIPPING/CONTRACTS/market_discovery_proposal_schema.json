{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "PERTURABO Market Discovery Proposal",
  "type": "object",
  "required": ["discovery_id", "market_input", "demon_map", "candidates", "availability", "validation"],
  "properties": {
    "discovery_id": {"type": "string"},
    "discovered_at": {"type": "string"},
    "market_input": {
      "type": "object",
      "required": ["market", "platform", "horizon"],
      "properties": {
        "market": {"type": "string", "minLength": 1},
        "platform": {"const": "youtube_shorts"},
        "horizon": {"enum": ["2h", "6h", "12h", "24h", "3d", "7d", "30d"]},
        "language": {"type": "string"},
        "production_niche": {"type": "string"}
      }
    },
    "demon_map": {"type": "array", "items": {"type": "object"}},
    "candidate_clusters": {"type": "object"},
    "candidates": {"type": "array", "items": {"$ref": "#/$defs/candidate"}},
    "red_candidates": {"type": "array", "items": {"$ref": "#/$defs/candidate"}},
    "blue_candidates": {"type": "array", "items": {"$ref": "#/$defs/candidate"}},
    "availability": {
      "type": "object",
      "required": ["requested", "observed_eligible", "invented", "quota_filled"],
      "properties": {
        "requested": {"type": "integer"},
        "observed_eligible": {"type": "integer"},
        "invented": {"const": 0},
        "quota_filled": {"type": "boolean"}
      }
    },
    "validation": {
      "type": "object",
      "required": ["state", "anti_invention"],
      "properties": {
        "state": {"const": "warsmith_review"},
        "premium_used": {"type": "boolean"},
        "anti_invention": {"const": "pass"}
      }
    }
  },
  "$defs": {
    "candidate": {
      "type": "object",
      "required": ["candidate_id", "keyword", "observed", "evidence_urls", "scores", "ocean", "safety_gate"],
      "properties": {
        "candidate_id": {"type": "string"},
        "keyword": {"type": "string"},
        "observed": {"const": true},
        "evidence_urls": {"type": "array", "items": {"type": "string", "format": "uri"}},
        "scores": {"type": "object"},
        "ocean": {"enum": ["red", "blue"]},
        "safety_gate": {"enum": ["pass", "block"]},
        "decision": {"const": "warsmith_review"}
      }
    }
  }
}
